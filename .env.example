# Kalacar Dashboard — environment variables
# Copy this to .env.local and fill in real values. Never commit .env.local.

# URL of the Next.js storefront + API server.
# Local dev: leave blank (defaults to http://127.0.0.1:3000 via Vite proxy).
# Production: set to your deployed Next.js URL, e.g. https://kalacar.in
VITE_API_BASE_URL=
